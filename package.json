{
  "name": "kims-parking-backend",
  "version": "1.0.0",
  "description": "KIMS Hospital Smart Parking — Express + Prisma + Supabase backend",
  "main": "src/server.js",
  "scripts": {
    "development": "cross-env NODE_ENV=development nodemon src/server.js",
    "production": "cross-env NODE_ENV=production node src/server.js",
    "dev": "npm run development",
    "postinstall": "prisma generate",
    "start": "npm run production",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env.production -- prisma migrate deploy",
    "prisma:studio:dev": "dotenv -e .env.development -- prisma studio",
    "prisma:studio:prod": "dotenv -e .env.production -- prisma studio",
    "seed": "cross-env NODE_ENV=development node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.4",
    "nodemon": "^3.1.7",
    "prisma": "^6.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "prisma": {
    "seed": "cross-env NODE_ENV=development node prisma/seed.js"
  }
}
