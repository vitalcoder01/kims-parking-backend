# Copy this to .env.development and .env.production and fill in real values.
NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"

CORS_ORIGIN="*"
LOG_LEVEL=debug

# Firebase Cloud Messaging (optional — pushes are silently disabled without it).
# Path to the service-account JSON, or the JSON itself, or base64 of the JSON.
FIREBASE_SERVICE_ACCOUNT=""

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────
# All optional: without PHONE_NUMBER_ID and ACCESS_TOKEN every send is a
# silent no-op and the server runs normally. Set them (in .env.development
# or .env.production — NODE_ENV picks the file) to start sending.
# Template NAMES live here rather than in code because Meta approves
# templates per account, so a hardcoded name works in one environment and
# 404s in the other.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_CHECKIN=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v21.0
# Shared secret echoed back to Meta when it verifies the inbound webhook.
WHATSAPP_VERIFY_TOKEN=
# Timezone used when telling a visitor a clock time over WhatsApp. The server
# may run in UTC; the visitor is not.
APP_TIMEZONE=Asia/Kolkata
