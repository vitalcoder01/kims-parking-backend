generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  employeeId          String         @unique
  password            String
  name                String
  role                Role
  department          String?
  cardCode            String?        @unique
  carNumber           String?
  phone               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  username            String         @unique
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  id                  Int            @id @default(autoincrement())
  attendance          Attendance[]
  driver              Driver?
  notifications       Notification[]
  parkedSlots         ParkingSlot[]  @relation("SlotDoctor")
  tasksAsDoctor       ParkingTask[]  @relation("DoctorTasks")
  deviceTokens        DeviceToken[]
  arrivalNotices      ArrivalNotice[]

  @@index([role])
  @@map("users")
}

model Driver {
  status           DriverStatus  @default(available)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  id               Int           @id @default(autoincrement())
  userId           Int           @unique
  currentTaskId    Int?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasksAsDriver    ParkingTask[] @relation("DriverTasks")
  visitorsAsDriver Visitor[]     @relation("VisitorDriver")

  @@index([status])
  @@map("drivers")
}

model ParkingSlot {
  id        String       @id
  block     String
  number    Int
  status    SlotStatus   @default(free)
  carNumber String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  doctorId  Int?
  taskId    Int?         @unique
  doctor    User?        @relation("SlotDoctor", fields: [doctorId], references: [id])
  task      ParkingTask? @relation("CurrentSlotTask", fields: [taskId], references: [id])

  @@index([block])
  @@index([status])
  @@index([doctorId, status])
  @@map("parking_slots")
}

model ParkingTask {
  type              TaskType
  carNumber         String
  slotId            String?
  status            TaskStatus   @default(assigned)
  assignedAt        DateTime?
  keyCollectedAt    DateTime?
  completedAt       DateTime?
  eta               Int?
  trackingProgress  Float?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  driverLat         Float?
  driverLng         Float?
  locationUpdatedAt DateTime?
  driverStartLat    Float?
  driverStartLng    Float?
  destinationLat    Float?
  destinationLng    Float?
  requestedAt       DateTime?
  acceptedAt        DateTime?
  // One doctor/staff member ever has at most one row with isCurrent=true —
  // enforced by a partial unique index (see the manual migration SQL,
  // Prisma's schema DSL can't express a WHERE-qualified unique constraint).
  // Every other row for that doctor is retired history, never deleted, so
  // "current status" and "history" are both just this same table with a
  // different filter, and there is no more "which of several tasks is the
  // real one" ambiguity anywhere in the app.
  isCurrent         Boolean      @default(true)
  id                Int          @id @default(autoincrement())
  doctorId          Int
  driverId          Int?
  occupyingSlot     ParkingSlot? @relation("CurrentSlotTask")
  doctor            User         @relation("DoctorTasks", fields: [doctorId], references: [id])
  driver            Driver?      @relation("DriverTasks", fields: [driverId], references: [id])

  @@index([doctorId])
  @@index([doctorId, createdAt])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([slotId])
  @@map("parking_tasks")
}

model Visitor {
  name               String
  carNumber          String?
  mobile             String
  slotId             String?
  driverName         String?
  status             VisitorStatus @default(pending)
  token              String
  trackingProgress   Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  retrievalRequested Boolean       @default(false)
  id                 Int           @id @default(autoincrement())
  driverId           Int?
  publicToken        String        @unique @default(cuid())
  pickedUpAt         DateTime?
  acceptedAt         DateTime?
  cancelReason       String?
  cancelledAt        DateTime?
  driverAssignedAt   DateTime?
  vehicleType        VehicleType   @default(car)
  driver             Driver?       @relation("VisitorDriver", fields: [driverId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([driverId])
  @@map("visitors")
}

model Notification {
  targetRole   String
  title        String
  body         String
  type         NotificationType @default(info)
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())
  id           Int              @id @default(autoincrement())
  targetUserId Int?
  targetUser   User?            @relation(fields: [targetUserId], references: [id])

  @@index([targetRole])
  @@index([targetUserId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model Attendance {
  date            DateTime  @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  vehiclesHandled Int       @default(0)
  gate            String?
  createdAt       DateTime  @default(now())
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendance")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// A doctor/staff member's "I'm on my way" notice, given before they've
// physically handed over a car — there's no ParkingTask to anchor this to
// yet (that's only created once the valet takes the key), so it's its own
// small, short-lived record. Cleared (fulfilledAt set) automatically the
// moment a real park ParkingTask is created for the same doctor, or
// manually by the valet if it was a no-show/mistake.
model ArrivalNotice {
  id          Int       @id @default(autoincrement())
  doctorId    Int
  doctor      User      @relation(fields: [doctorId], references: [id])
  eta         Int
  createdAt   DateTime  @default(now())
  fulfilledAt DateTime?

  @@index([doctorId])
  @@index([fulfilledAt])
  @@map("arrival_notices")
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

enum Role {
  doctor
  staff
  valet
  driver
  admin
}

enum DriverStatus {
  available
  busy
  off
}

enum TaskType {
  park
  retrieve
}

enum TaskStatus {
  assigned
  key_collected
  in_transit
  // Retrieve tasks only: driver has brought the car back to the valet
  // counter, but the owner hasn't been confirmed as having taken it yet —
  // completed only fires once the valet explicitly confirms the handover.
  delivered
  completed
  requested
  // Superseded by a later session before ever finishing (e.g. a forgotten
  // "assigned, no driver" job once the same doctor's next car comes in), or
  // explicitly cancelled by staff. Terminal, same as completed.
  cancelled
}

enum SlotStatus {
  free
  occupied
  reserved
}

enum VisitorStatus {
  pending
  parked
  // Driver has brought the car back to the valet counter, awaiting the
  // valet's explicit confirmation that the visitor actually took it.
  delivered
  retrieved
  cancelled
}

enum NotificationType {
  alarm
  info
  warning
}

enum VehicleType {
  car
  bike
}
