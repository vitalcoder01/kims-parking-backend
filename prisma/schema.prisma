generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  employeeId          String         @unique
  password            String
  name                String
  role                Role
  department          String?
  cardCode            String?        @unique
  carNumber           String?
  phone               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  username            String         @unique
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  id                  Int            @id @default(autoincrement())
  attendance          Attendance[]
  driver              Driver?
  notifications       Notification[]
  parkedSlots         ParkingSlot[]  @relation("SlotDoctor")
  tasksAsDoctor       ParkingTask[]  @relation("DoctorTasks")
  tasksAsValet        ParkingTask[]  @relation("ValetTasks")
  arrivalsAccepted    ArrivalNotice[] @relation("ValetArrivals")
  sessionsOwned       ParkingTask[]  @relation("ValetArrivalOwned")
  retrievalsOwned     ParkingTask[]  @relation("ValetRetrievalOwned")
  visitorsAsValet     Visitor[]      @relation("ValetVisitors")
  deviceTokens        DeviceToken[]
  arrivalNotices      ArrivalNotice[]

  @@index([role])
  @@map("users")
}

model Driver {
  status           DriverStatus  @default(available)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  id               Int           @id @default(autoincrement())
  userId           Int           @unique
  currentTaskId    Int?
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasksAsDriver    ParkingTask[] @relation("DriverTasks")
  visitorsAsDriver Visitor[]     @relation("VisitorDriver")

  @@index([status])
  @@map("drivers")
}

model ParkingSlot {
  id        String       @id
  block     String
  number    Int
  status    SlotStatus   @default(free)
  carNumber String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  doctorId  Int?
  taskId    Int?         @unique
  doctor    User?        @relation("SlotDoctor", fields: [doctorId], references: [id])
  task      ParkingTask? @relation("CurrentSlotTask", fields: [taskId], references: [id])

  @@index([block])
  @@index([status])
  @@index([doctorId, status])
  @@map("parking_slots")
}

model ParkingTask {
  type              TaskType
  carNumber         String
  slotId            String?
  status            TaskStatus   @default(assigned)
  assignedAt        DateTime?
  keyCollectedAt    DateTime?
  completedAt       DateTime?
  // The doctor's PLANNED DEPARTURE, in minutes (0 = now). This is planning
  // information for the valet team — never a promise to the doctor, and
  // never the basis of an ETA shown to them. Column stays `eta` so no data
  // migration is needed; the name is corrected here because calling it "eta"
  // is precisely what invited it to be rendered as an arrival estimate.
  plannedDepartureMinutes Int? @map("eta")
  // The absolute moment the doctor intends to leave. Derived from the minutes
  // above at request time, then stored, because scheduling needs a fixed point
  // the database can be queried against — "requestedAt + N minutes - lead
  // time" is not something a sweep can index or filter on. The minutes column
  // stays for rollout compatibility with installed apps.
  plannedDepartureAt      DateTime?
  // plannedDepartureAt minus the configured lead time: the moment the valet
  // should START the retrieval, and the moment this request stops being
  // informational and becomes actionable. Stored rather than recomputed so a
  // later change to the lead-time setting cannot retroactively move the
  // deadline of a request already in flight.
  retrievalReadyAt        DateTime?
  trackingProgress  Float?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  driverLat         Float?
  driverLng         Float?
  locationUpdatedAt DateTime?
  driverStartLat    Float?
  driverStartLng    Float?
  destinationLat    Float?
  destinationLng    Float?
  requestedAt       DateTime?
  acceptedAt        DateTime?
  // When the driver actually set off (marked in-transit). The retrieval
  // countdown anchors here, NOT to requestedAt: a doctor asking for their
  // car "in 10 minutes" is stating a deadline, and the trip itself doesn't
  // begin until someone is dispatched and moving. Anchoring the trip clock
  // to the request meant it burned down through valet response and driver
  // travel time, so it routinely read 00:00 before the car had moved.
  startedAt         DateTime?
  // Valet aborted a park job after the key was already handed over: the
  // driver must bring the car BACK to the counter rather than park it.
  // Set while the task is still key_collected/in_transit; the driver then
  // marks it returned (-> delivered) and the valet confirms (-> cancelled),
  // the same two-step handshake a retrieval already uses.
  recalledAt        DateTime?
  // One doctor/staff member ever has at most one row with isCurrent=true —
  // enforced by a partial unique index (see the manual migration SQL,
  // Prisma's schema DSL can't express a WHERE-qualified unique constraint).
  // Every other row for that doctor is retired history, never deleted, so
  // "current status" and "history" are both just this same table with a
  // different filter, and there is no more "which of several tasks is the
  // real one" ambiguity anywhere in the app.
  isCurrent         Boolean      @default(true)
  id                Int          @id @default(autoincrement())
  doctorId          Int
  driverId          Int?
  // The valet who owns this job — whoever took the key (park), or whoever
  // first assigned a driver (retrieve, since the doctor creates those). Only
  // this valet is alarmed when the job needs attention, instead of waking
  // every valet on shift. Nullable: a retrieval has no owner until a valet
  // acts on it, and ownership can be handed over (see valetClaimedAt).
  valetId           Int?
  valet             User?        @relation("ValetTasks", fields: [valetId], references: [id])
  // When the current owner took it — lets an unanswered job escalate to the
  // rest of the valets (and then admins) instead of sitting silently with
  // someone whose phone is dead.
  valetClaimedAt    DateTime?
  // Set once this job has been escalated past its owner, so the escalation
  // only ever fires once per stall rather than on every sweep.
  escalatedAt       DateTime?

  // ── Parking session ownership ────────────────────────────────────────
  // arrivalOwner is the valet who DISPATCHED THE DRIVER for this doctor's
  // arrival, and owns the session end to end from there. Not whoever accepted
  // the arrival broadcast: accepting only means "I'll meet them", and the
  // accepter is regularly not the person the doctor actually walks up to.
  // Written once and NEVER overwritten, so the history survives both a later
  // reassignment and a retrieval recovered by someone else.
  arrivalOwnerValetId Int?
  arrivalOwnerValet   User?      @relation("ValetArrivalOwned", fields: [arrivalOwnerValetId], references: [id])
  // When that dispatch happened — i.e. when the session gained its owner.
  arrivalAcceptedAt   DateTime?
  // retrievalOwner is whoever is actually running the departure leg. Equal to
  // arrivalOwner in the normal case; different only when the owner didn't
  // respond in time and another valet claimed the recovery.
  retrievalOwnerValetId Int?
  retrievalOwnerValet   User?    @relation("ValetRetrievalOwned", fields: [retrievalOwnerValetId], references: [id])
  retrievalAcceptedAt   DateTime?
  // OWNER | RECOVERY — how the retrieval owner came to hold it.
  retrievalOwnershipSource String?
  // When the owner-only response window opened. Null once claimed, or once
  // recovery has already broadcast it.
  ownerNotifiedAt     DateTime?
  // Set when the owner's window lapsed and the request went out to everyone.
  recoveryBroadcastAt DateTime?

  occupyingSlot     ParkingSlot? @relation("CurrentSlotTask")
  doctor            User         @relation("DoctorTasks", fields: [doctorId], references: [id])
  driver            Driver?      @relation("DriverTasks", fields: [driverId], references: [id])

  // A driver is on at most one live job at a time — enforced by a partial
  // unique index over (driverId) WHERE status IN (assigned, key_collected,
  // in_transit), written by hand in the migration since Prisma's DSL can't
  // express a WHERE-qualified unique constraint.
  @@index([retrievalReadyAt])
  @@index([doctorId])
  @@index([doctorId, createdAt])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
  @@index([slotId])
  @@map("parking_tasks")
}

model Visitor {
  name               String
  carNumber          String?
  mobile             String
  slotId             String?
  driverName         String?
  status             VisitorStatus @default(pending)
  token              String
  trackingProgress   Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  retrievalRequested Boolean       @default(false)
  id                 Int           @id @default(autoincrement())
  driverId           Int?
  publicToken        String        @unique @default(cuid())
  pickedUpAt         DateTime?
  acceptedAt         DateTime?
  cancelReason       String?
  cancelledAt        DateTime?
  driverAssignedAt   DateTime?
  vehicleType        VehicleType   @default(car)
  // Same ownership model as ParkingTask — the valet who registered this
  // visitor owns the job and is the one alarmed if it stalls.
  valetId            Int?
  valet              User?         @relation("ValetVisitors", fields: [valetId], references: [id])
  valetClaimedAt     DateTime?
  escalatedAt        DateTime?
  driver             Driver?       @relation("VisitorDriver", fields: [driverId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([driverId])
  @@map("visitors")
}

model Notification {
  targetRole   String
  title        String
  body         String
  type         NotificationType @default(info)
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())
  id           Int              @id @default(autoincrement())
  targetUserId Int?
  targetUser   User?            @relation(fields: [targetUserId], references: [id])

  @@index([targetRole])
  @@index([targetUserId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model Attendance {
  date            DateTime  @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  vehiclesHandled Int       @default(0)
  gate            String?
  createdAt       DateTime  @default(now())
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("attendance")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// A doctor/staff member's "I'm on my way" notice, given before they've
// physically handed over a car — there's no ParkingTask to anchor this to
// yet (that's only created once the valet takes the key), so it's its own
// small, short-lived record. Cleared (fulfilledAt set) automatically the
// moment a real park ParkingTask is created for the same doctor, or
// manually by the valet if it was a no-show/mistake.
model ArrivalNotice {
  id          Int       @id @default(autoincrement())
  doctorId    Int
  doctor      User      @relation(fields: [doctorId], references: [id])
  eta         Int
  createdAt   DateTime  @default(now())
  fulfilledAt DateTime?
  // The valet who accepted this arrival — "I'll walk out and meet them", so
  // the rest of the team stops watching for this doctor. Deliberately NOT
  // session ownership: that is decided later, by whoever dispatches the
  // driver (see ParkingTask.arrivalOwnerValetId), because an accepter can be
  // busy by the time the doctor actually turns up.
  // Null while still broadcast to every valet; set exactly once, by whoever
  // accepts first. Guarded by `WHERE ownerValetId IS NULL` so the database —
  // not frontend timing — decides the winner.
  ownerValetId   Int?
  ownerValet     User?     @relation("ValetArrivals", fields: [ownerValetId], references: [id])
  arrivalAcceptedAt DateTime?

  @@index([doctorId])
  @@index([fulfilledAt])
  @@index([ownerValetId])
  @@map("arrival_notices")
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}

enum Role {
  doctor
  staff
  valet
  driver
  admin
}

enum DriverStatus {
  available
  busy
  off
}

enum TaskType {
  park
  retrieve
}

enum TaskStatus {
  // Retrieve tasks only: a valet has taken ownership of the departure but
  // hasn't picked a driver yet. Distinct from `requested` (nobody has it) so
  // the queue can show "someone is on this" without inventing a driver.
  accepted
  assigned
  key_collected
  in_transit
  // Retrieve tasks only: driver has brought the car back to the valet
  // counter, but the owner hasn't been confirmed as having taken it yet —
  // completed only fires once the valet explicitly confirms the handover.
  delivered
  completed
  requested
  // Superseded by a later session before ever finishing (e.g. a forgotten
  // "assigned, no driver" job once the same doctor's next car comes in), or
  // explicitly cancelled by staff. Terminal, same as completed.
  cancelled
}

enum SlotStatus {
  free
  occupied
  reserved
}

enum VisitorStatus {
  pending
  parked
  // Driver has brought the car back to the valet counter, awaiting the
  // valet's explicit confirmation that the visitor actually took it.
  delivered
  retrieved
  cancelled
}

enum NotificationType {
  alarm
  info
  warning
}

enum VehicleType {
  car
  bike
}
